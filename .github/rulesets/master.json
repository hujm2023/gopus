{
  "name": "Protect master",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/master"],
      "exclude": []
    }
  },
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {"context": "lint-static-analysis", "integration_id": 15368},
          {"context": "test-linux", "integration_id": 15368},
          {"context": "perf-linux", "integration_id": 15368},
          {"context": "test-macos", "integration_id": 15368},
          {"context": "test-windows", "integration_id": 15368},
          {"context": "codeql (root)", "integration_id": 15368},
          {"context": "codeql (webrtc-control)", "integration_id": 15368},
          {"context": "codeql (webrtc-dred-loopback)", "integration_id": 15368}
        ]
      }
    }
  ]
}
